(version 2)
# ==============================================================================
# Custom Design Rules (DRC) for KiCad 10.x
# Stored in: '<project_name>.kicad_dru'
#
# Process Configuration:
# - Fabricator: JLCPCB (https://jlcpcb.com/capabilities/pcb-capabilities)
# - Substrate: FR-4, 2-Layer, 1.6 mm thickness
# - Surface Finish: ENIG (Lead-free RoHS compliant)
# - Outer Copper Weight: 1 oz (35 µm)
# - Outline Routing: Regular CNC (tolerance ±0.2 mm)
# - Via Class Selected: 0.3 mm drill / (0.4 mm min, 0.45 mm preferred diameter)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Traces & Routing
#	- min 0.10 mm (4 mil), 0.127 mm (5 mil) preferred
# ------------------------------------------------------------------------------
(rule "Trace width (1oz outer copper)"
	(layer outer)
	(condition "A.Type == 'track'")
	(constraint track_width (min 0.10mm))
)

(rule "Trace to trace spacing (1oz outer copper)"
	(layer outer)
	(condition "A.Type == 'track' && B.Type == 'track' && A.Net != B.Net")
	(constraint clearance (min 0.10mm))
)

# ------------------------------------------------------------------------------
# 2. Pad & SMT Clearances
#	- Pad to track clearance: 0.10 mm
#	- SMD pad to pad clearance (different nets): 0.15 mm
# ------------------------------------------------------------------------------
(rule "Clearance: SMD pad to SMD pad (different nets)"
	(layer outer)
	(condition "A.Type == 'pad' && B.Type == 'pad' && A.Net != B.Net")
	(constraint clearance (min 0.15mm))
)

(rule "Clearance: Pad to track (different nets)"
	(layer outer)
	(condition "A.Type == 'pad' && B.Type == 'track' && A.Net != B.Net")
	(constraint clearance (min 0.10mm))
)

# ------------------------------------------------------------------------------
# 3. Vias (Cheapest option: 0.3mm drill / 0.4-0.45mm diameter)
# - Via drill min: 0.30 mm
# - Via diameter min: 0.40 mm (0.45 mm preferred)
# - Via annular ring min: 0.05 mm
# - Via hole to track: 0.20 mm
# ------------------------------------------------------------------------------
(rule "Via definition (0.3mm drill / 0.40mm min diameter)"
	(condition "A.Type == 'via'")
	(constraint hole_size (min 0.30mm))
	(constraint via_diameter (min 0.40mm))
	(constraint annular_width (min 0.05mm))
)

(rule "Clearance: Via hole to track (different nets)"
	(layer outer)
	(condition "A.Type == 'via' && B.Type == 'track' && A.Net != B.Net")
	(constraint hole_clearance (min 0.20mm))
	(constraint clearance (min 0.10mm))
)

(rule "Clearance: Via to via copper (different nets)"
	(layer outer)
	(condition "A.Type == 'via' && B.Type == 'via' && A.Net != B.Net")
	(constraint clearance (min 0.10mm))
)

# ------------------------------------------------------------------------------
# 4. Through-Hole Component Pads (PTH) & Plated Slots
# - Recommended PTH size >= 0.50 mm
# - Minimum plated slot width: 0.50 mm (length >= 2x width)
# - 2-layer 1 oz PTH annular ring: absolute min 0.18 mm
# ------------------------------------------------------------------------------
(rule "PTH pad / plated slot definition"
	(layer outer)
	(condition "A.Type == 'pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_size (min 0.50mm) (max 6.30mm))
	(constraint annular_width (min 0.18mm))
)

# ------------------------------------------------------------------------------
# 5. Non-Plated Through-Holes (NPTH) & Non-Plated Slots
# - Minimum circular NPTH hole size: 0.50 mm
# - Minimum non-plated slot width: 1.0 mm
# - NPTH to track: 0.20 mm
# ------------------------------------------------------------------------------
(rule "NPTH circular hole size"
	(condition "!A.isPlated() && A.Pad_Shape != 'Oval'")
	(constraint hole_size (min 0.50mm) (max 6.30mm))
)

(rule "NPTH slot width"
	(condition "!A.isPlated() && A.Pad_Shape == 'Oval'")
	(constraint hole_size (min 1.00mm) (max 6.30mm))
)

(rule "Clearance: NPTH to track (hole to track)"
	(condition "!A.isPlated() && B.Type == 'track'")
	(constraint hole_clearance (min 0.20mm))
)

(rule "Clearance: NPTH hole to copper general"
	(condition "!A.isPlated() && B.isPlated()")
	(constraint hole_clearance (min 0.20mm))
)

# ------------------------------------------------------------------------------
# 6. Hole-to-Track & Hole-to-Hole Clearances
# - PTH hole edge to track: min 0.28 mm (0.35 mm recommended)
# - Via hole-to-hole spacing: 0.20 mm
# - Pad hole-to-hole spacing: 0.45 mm
# ------------------------------------------------------------------------------
(rule "Clearance: PTH hole to track (different nets)"
	(condition "A.Pad_Type == 'Through-hole' && B.Type == 'track' && A.Net != B.Net")
	(constraint hole_clearance (min 0.35mm))
)

(rule "Hole to hole clearance: via to via"
	(condition "A.Type == 'via' && B.Type == 'via'")
	(constraint hole_to_hole (min 0.20mm))
)

(rule "Hole to hole clearance: pad involved (different nets)"
	(condition "A.Type == 'pad' && A.Net != B.Net")
	(constraint hole_to_hole (min 0.45mm))
)

(rule "Hole to hole clearance: pad involved (same net)"
	(condition "A.Type == 'pad' && A.Net == B.Net")
	(constraint hole_to_hole (min 0.20mm))
)

# ------------------------------------------------------------------------------
# 7. Board Edge Clearance (Regular CNC Outline ±0.2mm tolerance)
# - Routed board edge to copper: min 0.20 mm
# ------------------------------------------------------------------------------
(rule "Copper to routed board edge clearance"
	(condition "A.isPlated()")
	(constraint edge_clearance (min 0.20mm))
)

# ------------------------------------------------------------------------------
# 8. Solder Mask
# - Solder mask sliver (bridge / web): min 0.10 mm (green mask; 0.13 mm for black/white)
# ------------------------------------------------------------------------------
(rule "Solder mask sliver / bridge width"
	(constraint solder_mask_sliver (min 0.13mm))
)

# ------------------------------------------------------------------------------
# 9. Silkscreen / Legend
# - Minimum line width / text thickness: >= 0.15 mm
# - Minimum text height: >= 1.0 mm (40 mil)
# - Minimum clearance from pad to silkscreen: 0.15 mm
# Rule override: 0.8mm height, 0.1mm thickness should be legible, clearance 0.099mm due to KiCad default footprints
# ------------------------------------------------------------------------------
(rule "Silkscreen text dimensions"
	(layer "?.SilkS")
	(condition "A.Type == 'text' || A.Type == 'text_box'")
	(constraint text_thickness (min 0.1mm))
	(constraint text_height (min 0.80mm))
#	(constraint text_thickness (min 0.15mm))
#	(constraint text_height (min 1.00mm))
)

(rule "Clearance: Silkscreen to pad"
	(layer outer)
	(condition "A.Type == 'pad' && B.Layer == '?.SilkS'")
	(constraint silk_clearance (min 0.099mm))
#	(constraint silk_clearance (min 0.15mm))
)